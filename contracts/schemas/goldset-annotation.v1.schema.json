{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://citetrace.example/schemas/goldset-annotation.v1.json",
  "title": "CiteTrace gold-set annotation v1",
  "description": "Validation schema for a single human-annotated gold-set row.",
  "type": "object",
  "required": [
    "case_id",
    "split",
    "domain",
    "citing_asset_id",
    "citing_work_version_id",
    "citation_cluster_id",
    "citation_anchor_id",
    "reference_entry_id",
    "claim_text",
    "claim_start_offset",
    "claim_end_offset",
    "claim_qualifiers_json",
    "gold_work_id",
    "gold_work_version_id",
    "resolution_status",
    "source_access_level",
    "gold_source_span_ids_json",
    "gold_evidence_relation",
    "gold_scope_observations_json",
    "gold_citation_intents_json",
    "gold_transformations_json",
    "expected_abstention_code",
    "annotation_status",
    "annotator_a",
    "annotator_b",
    "adjudicator",
    "notes"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "description": "Stable identifier; one per case."
    },
    "split": {
      "type": "string",
      "enum": ["development", "calibration", "test", "challenge"]
    },
    "domain": {
      "type": "string",
      "minLength": 1,
      "description": "Research domain; one of the blueprint's 12 domains or a new one (recorded in the rubric)."
    },
    "citing_asset_id": { "type": "string", "minLength": 1 },
    "citing_work_version_id": { "type": "string", "minLength": 1 },
    "citation_cluster_id": { "type": "string", "minLength": 1 },
    "citation_anchor_id": { "type": "string" },
    "reference_entry_id": { "type": "string", "minLength": 1 },
    "claim_text": { "type": "string", "minLength": 1 },
    "claim_start_offset": { "type": "integer", "minimum": 0 },
    "claim_end_offset": { "type": "integer", "minimum": 0 },
    "claim_qualifiers_json": {
      "type": "array",
      "items": { "type": "object" }
    },
    "gold_work_id": { "type": "string" },
    "gold_work_version_id": { "type": "string" },
    "resolution_status": {
      "type": "string",
      "enum": [
        "exact_version",
        "correct_work_wrong_or_uncertain_version",
        "ambiguous",
        "unresolved",
        "incorrect"
      ]
    },
    "source_access_level": {
      "type": "string",
      "enum": [
        "open_access_full_text",
        "open_access_abstract_only",
        "user_uploaded",
        "publisher_paywalled",
        "not_accessible"
      ]
    },
    "gold_source_span_ids_json": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gold_evidence_relation": {
      "type": "string",
      "enum": [
        "direct_support",
        "partial_support",
        "indirect_support",
        "contradicts",
        "overgeneralized",
        "scope_mismatch",
        "no_relevant_evidence",
        "insufficient_evidence",
        "inaccessible_source"
      ]
    },
    "gold_scope_observations_json": {
      "type": "array",
      "items": { "type": "object" }
    },
    "gold_citation_intents_json": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "gold_transformations_json": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expected_abstention_code": {
      "type": ["string", "null"]
    },
    "annotation_status": {
      "type": "string",
      "enum": ["pending", "annotated_a", "annotated_b", "adjudicated", "rejected"]
    },
    "annotator_a": { "type": "string" },
    "annotator_b": { "type": "string" },
    "adjudicator": { "type": "string" },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
